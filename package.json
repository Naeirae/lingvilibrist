{
  "name": "lingvilibrist",
  "version": "0.2.0",
  "private": true,
  "description": "Extensible Russian proofreading and editorial review tool with deterministic rules and review-first findings.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:extension",
    "build:extension": "node scripts/build-extension.mjs",
    "test": "node --test",
    "test:core": "node --test packages/core/test/*.test.js",
    "test:rules": "node --test packages/rules/test/*.test.js",
    "test:adapters": "node --test packages/adapters/test/*.test.js",
    "check:extension": "node --check apps/chrome-extension/background.js && node --check apps/chrome-extension/popup.js",
    "check": "npm run test && npm run check:extension && npm run build:extension"
  }
}
